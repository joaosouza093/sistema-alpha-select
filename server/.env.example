# Copie para server/.env e ajuste. NUNCA versione o arquivo .env com segredos reais.
# Ambientes: development | staging (homologação) | production
APP_ENV=development
HOST=127.0.0.1
PORT=3000
# URL pública (links de convite/recuperação). Em homologação/produção: https obrigatório.
APP_URL=http://localhost:5173

# Papel sujeito a RLS (sem BYPASSRLS) — usado em todas as operações de usuário.
DATABASE_URL=postgres://alpha_app:TROQUE_ESTA_SENHA@127.0.0.1:5432/alpha_dev
# Papel proprietário — migrações, autenticação e scripts administrativos.
DATABASE_OWNER_URL=postgres://alpha_owner:TROQUE_ESTA_SENHA@127.0.0.1:5432/alpha_dev
DATABASE_SSL=false
# Certificado (PEM) da autoridade do banco — obrigatório para TLS verificado no Supabase.
DATABASE_SSL_CA=
# Conexões por instância (serverless: 1–2).
DB_POOL_MAX=15

# disk = disco local/volume; supabase = Supabase Storage (bucket privado)
STORAGE_DRIVER=disk
# Diretório privado dos arquivos (disk) ou só de temporários (supabase).
STORAGE_DIR=./.storage
# Somente com STORAGE_DRIVER=supabase. A service_role fica APENAS no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documentos-candidatos
# memory (uma instância) ou postgres (serverless / várias instâncias)
RATE_LIMIT_STORE=memory
MAX_UPLOAD_MB=10

# Somente se o frontend for servido de outra origem (separar por vírgula).
CORS_ORIGINS=
# true quando atrás de proxy reverso/balanceador confiável (IP real para limites de tentativas).
TRUST_PROXY=false

# Homologação/produção: defina SMTP_URL, ou MAIL_MODE=manual (o administrador copia
# os links de convite/redefinição e envia por canal seguro).
# Ex.: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=
MAIL_MODE=
MAIL_FROM=Alpha Select <nao-responda@seu-dominio.com.br>

SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
# Build do frontend servido pelo backend (homologação/produção).
WEB_DIST_DIR=../web/dist
LOG_LEVEL=info
